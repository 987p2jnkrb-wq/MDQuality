---

<!doctype html>
<html lang={lang} data-detect-language={detectLanguage ? "true" : "false"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#080b10" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={"https://mdquality.pl" + englishPath} />
    <link rel="alternate" hreflang="pl" href={"https://mdquality.pl" + polishPath} />
    <link rel="alternate" hreflang="x-default" href={"https://mdquality.pl" + englishPath} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MD Quality" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

    <script is:inline>
      (() => {
        try {
          const root = document.documentElement;
          if (root.dataset.detectLanguage !== "true") return;

          const saved = localStorage.getItem("mdq-lang");
          if (saved === "pl") {
            window.location.replace("/pl" + window.location.pathname + window.location.search + window.location.hash);
            return;
          }
          if (saved === "en") return;

          const primary = (navigator.languages?.[0] || navigator.language || "").toLowerCase();
          if (primary.startsWith("pl")) {
            window.location.replace("/pl" + window.location.pathname + window.location.search + window.location.hash);
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <header>
      <nav class="container" aria-label={lang === "pl" ? "Główna nawigacja" : "Primary navigation"}>
        <a class="logo" href={homePath} aria-label="MD Quality">MD<span>Quality</span></a>

        <div class="nav-links">
          <a href={homePath} aria-current={isHome ? "page" : undefined}>{pageCopy.start}</a>
          <a href={offerPath} aria-current={isOffer ? "page" : undefined}>{pageCopy.offer}</a>
          <a href={experiencePath} aria-current={page === "experience" ? "page" : undefined}>{pageCopy.experience}</a>
        </div>

        <div class="language-switch" aria-label={lang === "pl" ? "Język" : "Language"}>
          <a class:list={[lang === "en" && "active"]} href={englishPath} data-lang="en">EN</a>
          <span>/</span>
          <a class:list={[lang === "pl" && "active"]} href={polishPath} data-lang="pl">PL</a>
        </div>

        <a class="header-cta" href={offerPath + "#contact"}>{pageCopy.contact}</a>
      </nav>
    </header>

    <main>
      {isHome && <>
        <section class="hero container compact-hero">
          <div class="hero-copy">
            <div class="badge">{pageCopy.badge}</div>
            <h1>{pageCopy.title}<span>{pageCopy.accent}</span></h1>
            <p class="hero-text">{pageCopy.text}</p>
            <div class="hero-buttons">
              <a class="button primary" href={offerPath}>{pageCopy.offer}</a>
              <a class="button secondary" href="#work">{pageCopy.project}</a>
            </div>
          </div>
        </section>
        <section class="container home-help">
          <h2>{pageCopy.help}</h2>
          <div class="help-grid">{pageCopy.cards.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div>
          <a class="text-link" href={offerPath}>{pageCopy.details} <span aria-hidden="true">→</span></a>
        </section>
      </>}
      {isOffer && <>
        <section class="hero container compact-hero">
          <div class="hero-copy">
            <p class="eyebrow">{pageCopy.offer}</p>
            <h1>{pageCopy.offerTitle}</h1>
            <p class="hero-text">{pageCopy.offerText}</p>
            <a class="button primary" href="#contact">{pageCopy.contact}</a>
          </div>
        </section>
        <section class="container collaboration" aria-labelledby="collaboration-title">
          <h2 id="collaboration-title">{pageCopy.collaborationTitle}</h2>
          <p>{pageCopy.collaborationText}</p>
          <ul class="collaboration-forms">{pageCopy.collaborationForms.map((form) => <li>{form}</li>)}</ul>
          <div class="collaboration-links">
            <a class="text-link" href="mailto:mikolajdworak@icloud.com">{pageCopy.collaborationContact} <span aria-hidden="true">→</span></a>
            <a class="text-link" href={experiencePath}>{pageCopy.collaborationExperience}</a>
          </div>
        </section>
      <section class="overview-section">
        <div class="container">
          <div class="overview-heading">
            <p class="eyebrow">{t.overview.eyebrow}</p>
            <h2>{t.overview.title}</h2>
          </div>
          <div class="overview-grid">
            {t.overview.cards.map(([title, text]) => (
              <article class="overview-card">
                <span>{title}</span>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="quick-review" class="section container quick-review-section">
        <div class="quick-review">
          <div class="quick-review-copy">
            <p class="eyebrow">{t.quick.eyebrow}</p>
            <h2>{t.quick.title}</h2>
            <p class="section-intro">{t.quick.text}</p>
            <div class="hero-buttons quick-review-actions">
              <a class="button primary" href="#contact">{t.quick.primary}</a>
              <a class="button secondary" href={sampleReportPath}>{t.quick.secondary}</a>
            </div>
          </div>

        </div>

        <ReviewScope lang={lang} />
        <details class="disclosure quick-details">
          <summary>{t.quick.detailsLabel}</summary>
          <div class="disclosure-body">
            <div class="quick-review-grid">
              {t.quick.items.map(([number, title, text]) => (
                <article>
                  <span>{number}</span>
                  <strong>{title}</strong>
                  <p>{text}</p>
                </article>
              ))}
            </div>
          </div>
        </details>
      </section>

      <section id="services" class="section container">
        <div class="section-heading">
          <p class="eyebrow">{t.services.eyebrow}</p>
          <h2>{t.services.title}</h2>
          <p class="section-intro">{t.services.intro}</p>
        </div>

        <div class="services-grid">
          {t.services.cards.map((service) => (
            <article class="service-card">
              <span class="card-number">{service.number}</span>
              <h3>{service.title}</h3>
              <p class="service-summary">{service.summary}</p>

              <details class="service-details">
                <summary>{t.services.detailsLabel}</summary>
                <div class="service-details-body">
                  <p class="service-best-for"><strong>{t.services.bestFor}:</strong> {service.bestFor}</p>
                  <div class="outcomes">
                    <span>{t.services.youGet}</span>
                    <ul>
                      {service.outcomes.map((outcome) => <li>{outcome}</li>)}
                    </ul>
                  </div>
                </div>
              </details>
            </article>
          ))}
        </div>

        <details class="secondary-services disclosure">
          <summary>
            <span>{t.services.additional}</span>
            <strong>{t.services.additionalTitle}</strong>
          </summary>
          <div class="secondary-grid disclosure-body">
            {t.services.extra.map(([title, text]) => (
              <article>
                <h4>{title}</h4>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </details>
      </section>

      <section id="process" class="section process-section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">{t.process.eyebrow}</p>
            <h2>{t.process.title}</h2>
            <p class="section-intro">{t.process.intro}</p>
          </div>

          <div class="process-grid">
            {t.process.steps.map(([number, title, text]) => (
              <article class="process-step">
                <span>{number}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      </>}

      {isHome && <section id="work" class="section container">
        <div class="section-heading work-heading">
          <p class="eyebrow">{t.work.eyebrow}</p>
          <h2>{t.work.title}</h2>
          <p class="section-intro">{t.work.intro}</p>
        </div>

        <ProjectVersionCarousel id="myanalyze-history" lang={lang} versions={projectVersions}>
          {projectVersions.map((version) => <article class:list={["project", { "project-current": version.screens }]} aria-label={"MyAnalyze " + version.version}>
            <div class="project-copy">
              <p class="project-label">{version.label}</p>
              <h3>{version.title}</h3>
              <p>{version.summary}</p>
              {version.value && <ul class="release-value"><li>{version.value}</li></ul>}
              <div class="tags">{version.features.map((feature) => <span>{feature}</span>)}</div>
              <div class="project-actions">
                {version.downloadUrl && <a class="button primary" href={version.downloadUrl}>{lang === "pl" ? "Pobierz na Windows" : "Download for Windows"}</a>}
                <a class="button secondary" href={myAnalyzePublicUrl} target="_blank" rel="noreferrer">{t.work.projectButton}</a>
                <a class="button secondary" href={version.releaseUrl} target="_blank" rel="noreferrer">{version.releaseLabel}</a>
              </div>
            </div>
            {version.screens ? <div class="project-mobile-gallery" tabindex="0" role="group" aria-label={lang === "pl" ? "Zrzuty ekranu MyAnalyze 4.1. Przewiń, aby zobaczyć kolejne." : "MyAnalyze 4.1 screenshots. Scroll to see more."}>
              {version.screens.map((screen) => <a class="mobile-screen" href={screen.src} target="_blank" rel="noreferrer">
                <img src={screen.src} alt={"MyAnalyze 4.1 - " + screen.title} width={screen.width} height={screen.height} loading="lazy" decoding="async" />
                <span>{screen.title}</span>
              </a>)}
            </div> : <a class:list={["project-preview", "project-image-link", { "project-mobile-preview": version.image.height > version.image.width }]} style={"--preview-aspect: " + version.image.width + " / " + version.image.height} href={version.image.src} target="_blank" rel="noreferrer">
              <img src={version.image.src} alt={"MyAnalyze " + version.version + " - " + version.image.title} width={version.image.width} height={version.image.height} loading="lazy" decoding="async" />
            </a>}
          </article>)}
        </ProjectVersionCarousel>
        <div class="tags project-stack"><span>React</span><span>TypeScript</span><span>Node.js</span><span>SQLite</span><span>Electron</span><span>Jest</span></div>

        <details class="work-details disclosure">
          <summary>{t.work.detailsLabel}</summary>
          <div class="disclosure-body">
            <div class="project-proof">
              <span>{t.work.proofLabel}</span>
              <ul>
                {t.work.bullets.map((item) => <li>{item}</li>)}
              </ul>
            </div>

            <div class="project-gallery">
              {projectScreens.slice(1).map((screen) => (
                  <a class="project-shot" href={screen.src} target="_blank" rel="noreferrer">
                  <img src={screen.src} alt={"MyAnalyze - " + screen.title} width={screen.width} height={screen.height} loading="lazy" decoding="async" />
                  <span>{screen.title}</span>
                </a>
              ))}
            </div>
            <WorkEvidence lang={lang} />
          </div>
        </details>
      </section>

      }

      {page === "experience" && <Experience lang={lang} />}

      {isOffer && <>
      <section class="section faq-section">
        <div class="container faq-layout">
          <div class="section-heading">
            <p class="eyebrow">{t.faq.eyebrow}</p>
            <h2>{t.faq.title}</h2>
          </div>

          <div class="faq-list">
            {t.faq.items.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="section container">
        <div class="contact">
          <p class="eyebrow">{t.contact.eyebrow}</p>
          <h2>{t.contact.title}</h2>
          <p>{t.contact.text}</p>

          <ContactBrief lang={lang} />

          <div class="social-links">
            <a href="https://www.linkedin.com/in/mikdwo/" target="_blank" rel="noreferrer">LinkedIn</a>
            <a href={myAnalyzePublicUrl} target="_blank" rel="noreferrer">{t.contact.github}</a>
          </div>
        </div>
      </section>
      </>}
      {isHome && <section class="container compact-contact"><a href="mailto:mikolajdworak@icloud.com">mikolajdworak@icloud.com</a><a href="https://www.linkedin.com/in/mikdwo/" target="_blank" rel="noreferrer">LinkedIn</a><a href={offerPath + "#contact"}>{pageCopy.contact} <span aria-hidden="true">→</span></a></section>}
    </main>

    <footer class="container">
      <div class="footer-brand">
        <div class="logo">MD<span>Quality</span></div>
        <p>© {new Date().getFullYear()} MD Quality · Mikołaj Dworak · {page === "experience" ? (lang === "pl" ? "Wsparcie aplikacji, testowanie i diagnostyka" : "Application support, testing and diagnostics") : t.footer}</p>
      </div>
      <div class="footer-links">
        <a href={lang === "pl" ? "/pl/privacy/" : "/privacy/"}>
          {lang === "pl" ? "Polityka prywatności" : "Privacy"}
        </a>
        <a href={lang === "pl" ? "/pl/terms/" : "/terms/"}>
          {lang === "pl" ? "Warunki korzystania" : "Website terms"}
        </a>
      </div>
    </footer>

    {isHome && <script is:inline data-offer-path={offerPath} data-experience-path={experiencePath}>
      (() => {
        const paths = document.currentScript.dataset;
        const redirect = () => {
          const hash = window.location.hash;
          const target = ["#quick-review", "#services", "#process", "#contact"].includes(hash)
            ? paths.offerPath + window.location.search + hash
            : hash === "#about" ? paths.experiencePath + window.location.search : null;
          if (target) window.location.replace(target);
        };
        redirect();
        window.addEventListener("hashchange", redirect);
      })();
    </script>}
    <script is:inline>
      document.querySelectorAll("[data-lang]").forEach((link) => {
        link.addEventListener("click", () => {
          try {
            localStorage.setItem("mdq-lang", link.getAttribute("data-lang") || "en");
          } catch {}
        });
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 90px; }
  :global(body) {
    margin: 0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: radial-gradient(circle at 82% 6%, rgba(63, 142, 196, 0.14), transparent 28%), #080b10;
    color: #f5f7fa;
    line-height: 1.6;
  }
  :global(:focus-visible) { outline: 2px solid #7dd3fc; outline-offset: 4px; }
  :global(::selection) { background: #7dd3fc; color: #071019; }

  .container { width: min(1160px, calc(100% - 40px)); margin: 0 auto; }
  header {
    border-bottom: 1px solid rgba(35, 45, 58, 0.78);
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(8, 11, 16, 0.9);
    backdrop-filter: blur(18px);
  }
  nav { min-height: 72px; display: flex; align-items: center; gap: 22px; }
  .logo { flex: 0 0 auto; font-size: 21px; font-weight: 850; letter-spacing: -0.7px; text-decoration: none; color: white; }
