];

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "MD Quality",
  url: canonical,
  email: "mikolajdworak@icloud.com",
  description: pageDescription,
  founder: { "@type": "Person", name: "Mikołaj Dworak" },
  sameAs: [
