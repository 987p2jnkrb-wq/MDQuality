<!doctype html>
<html lang={lang} data-detect-language={detectLanguage ? "true" : "false"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#080b10" />

    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href="https://mdquality.pl/" />
    <link rel="alternate" hreflang="pl" href="https://mdquality.pl/pl/" />
    <link rel="alternate" hreflang="x-default" href="https://mdquality.pl/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MD Quality" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

    <script is:inline>
      (() => {
        try {
          const root = document.documentElement;
          if (root.dataset.detectLanguage !== "true") return;

          const saved = localStorage.getItem("mdq-lang");
          if (saved === "pl") {
            window.location.replace("/pl/" + window.location.search + window.location.hash);
            return;
          }
          if (saved === "en") return;

          const primary = (navigator.languages?.[0] || navigator.language || "").toLowerCase();
          if (primary.startsWith("pl")) {
            window.location.replace("/pl/" + window.location.search + window.location.hash);
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <header>
      <nav class="container" aria-label={lang === "pl" ? "Główna nawigacja" : "Primary navigation"}>
        <a class="logo" href={homePath} aria-label="MD Quality">MD<span>Quality</span></a>

        <div class="nav-links">
          <a href="#quick-review">{t.nav.quick}</a>
          <a href="#services">{t.nav.services}</a>
          <a href="#process">{t.nav.process}</a>
          <a href="#work">{t.nav.work}</a>
          <a href="#about">{t.nav.about}</a>
        </div>

        <div class="language-switch" aria-label={lang === "pl" ? "Język" : "Language"}>
          <a class:list={[lang === "en" && "active"]} href="/" data-lang="en">EN</a>
          <span>/</span>
          <a class:list={[lang === "pl" && "active"]} href="/pl/" data-lang="pl">PL</a>
        </div>

        <a class="header-cta" href="#contact">{t.nav.quote}</a>
      </nav>
    </header>

    <main>
      <section class="hero container">
        <div class="hero-copy">
          <div class="badge">{t.hero.badge}</div>

          <h1>
            {t.hero.title}
            <span>{t.hero.accent}</span>
          </h1>

          <p class="hero-text">{t.hero.text}</p>

          <div class="hero-buttons">
            <a class="button primary" href="#contact">{t.hero.primary}</a>
            <a class="button secondary" href={sampleReportPath}>{t.hero.secondary}</a>
          </div>

          <div class="hero-meta">
            {t.hero.meta.map((item) => <span>{item}</span>)}
          </div>
        </div>

        <aside class="hero-panel">
          <p class="panel-label">{t.hero.fitLabel}</p>
          <div class="need-list">
            {t.hero.fit.map((item) => (
              <div>
                <strong>{item.title}</strong>
                <span>{item.text}</span>
              </div>
            ))}
          </div>
        </aside>
      </section>

      <section class="proof-strip">
        <div class="container proof-grid">
          {t.proof.map(([title, text]) => (
            <div>
              <strong>{title}</strong>
              <span>{text}</span>
            </div>
          ))}
        </div>
      </section>

      <section id="quick-review" class="section container quick-review-section">
        <div class="quick-review">
          <div class="quick-review-copy">
            <p class="eyebrow">{t.quick.eyebrow}</p>
            <h2>{t.quick.title}</h2>
            <p class="section-intro">{t.quick.text}</p>
            <div class="hero-buttons quick-review-actions">
              <a class="button primary" href="#contact">{t.quick.primary}</a>
              <a class="button secondary" href={sampleReportPath}>{t.quick.secondary}</a>
            </div>
          </div>

          <div class="quick-review-grid">
            {t.quick.items.map(([number, title, text]) => (
              <article>
                <span>{number}</span>
                <strong>{title}</strong>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
        <ReviewScope lang={lang} />
      </section>

      <section id="services" class="section container">
        <div class="section-heading">
          <p class="eyebrow">{t.services.eyebrow}</p>
          <h2>{t.services.title}</h2>
          <p class="section-intro">{t.services.intro}</p>
        </div>

        <div class="services-grid">
          {t.services.cards.map((service) => (
            <article class="service-card">
              <span class="card-number">{service.number}</span>
              <h3>{service.title}</h3>
              <p class="service-summary">{service.summary}</p>

              <div class="best-for">
                <span>{t.services.bestFor}</span>
                <p>{service.bestFor}</p>
              </div>

              <div class="outcomes">
                <span>{t.services.youGet}</span>
                <ul>
                  {service.outcomes.map((outcome) => <li>{outcome}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>

        <div class="secondary-services">
          <div class="secondary-heading">
            <p class="eyebrow">{t.services.additional}</p>
            <h3>{t.services.additionalTitle}</h3>
          </div>

          <div class="secondary-grid">
            {t.services.extra.map(([title, text]) => (
              <article>
                <h4>{title}</h4>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="deliverables" class="section container">
        <div class="section-split">
          <div class="section-heading">
            <p class="eyebrow">{t.outputs.eyebrow}</p>
            <h2>{t.outputs.title}</h2>
          </div>
          <p class="section-intro">{t.outputs.intro}</p>
        </div>

        <div class="deliverables-grid">
          {t.outputs.cards.map(([title, text]) => (
            <article class="deliverable-card">
              <div class="deliverable-icon" aria-hidden="true"></div>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>

        <div class="sample-report">
          <div>
            <p class="project-label">{t.outputs.demo}</p>
            <h3>{t.outputs.demoTitle}</h3>
            <p>{t.outputs.demoText}</p>
          </div>
          <a class="button secondary" href={sampleReportPath}>{t.outputs.demoButton}</a>
        </div>
      </section>

      <section id="process" class="section process-section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">{t.process.eyebrow}</p>
            <h2>{t.process.title}</h2>
            <p class="section-intro">{t.process.intro}</p>
          </div>

          <div class="process-grid">
            {t.process.steps.map(([number, title, text]) => (
              <article class="process-step">
                <span>{number}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="work" class="section container">
        <div class="section-heading work-heading">
          <p class="eyebrow">{t.work.eyebrow}</p>
          <h2>{t.work.title}</h2>
          <p class="section-intro">{t.work.intro}</p>
        </div>

        <article class="project">
          <div class="project-copy">
            <p class="project-label">{t.work.caseLabel}</p>
            <h3>{t.work.caseTitle}</h3>
            <p>{t.work.caseText}</p>

            <div class="project-proof">
              <span>{t.work.proofLabel}</span>
              <ul>
                {t.work.bullets.map((item) => <li>{item}</li>)}
              </ul>
            </div>

            <div class="tags">
              <span>React</span>
              <span>TypeScript</span>
              <span>Node.js</span>
              <span>SQLite</span>
              <span>Electron</span>
              <span>Jest</span>
            </div>

            <div class="project-actions">
              <a class="button secondary" href={myAnalyzePublicUrl} target="_blank" rel="noreferrer">
                {t.work.projectButton}
              </a>
              <a class="button secondary" href={myAnalyzeReleaseUrl} target="_blank" rel="noreferrer">
                {t.work.releaseButton}
              </a>
            </div>
          </div>

          <a class="project-preview project-image-link" href={projectScreens[0].src} target="_blank" rel="noreferrer">
            <img src={projectScreens[0].src} alt="MyAnalyze 2.0.0 dashboard" loading="lazy" />
          </a>
        </article>

        <div class="project-gallery">
          {projectScreens.slice(1).map((screen) => (
            <a class="project-shot" href={screen.src} target="_blank" rel="noreferrer">
              <img src={screen.src} alt={"MyAnalyze - " + screen.title} loading="lazy" />
              <span>{screen.title}</span>
            </a>
          ))}
        </div>
        <WorkEvidence lang={lang} />
      </section>

      <section id="about" class="section container about-section">
        <div class="about-copy">
          <p class="eyebrow">{t.about.eyebrow}</p>
          <h2>{t.about.title}</h2>
          <p class="about-lead">{t.about.lead}</p>
          <p>{t.about.p1}</p>
          <p>{t.about.p2}</p>
          <p>{t.about.p3}</p>
        </div>

        <aside class="about-panel">
          <p class="panel-label">{t.about.principles}</p>
          <ul>
            {t.about.list.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </section>

      <section class="section container">
        <div class="section-split toolkit-heading">
          <div class="section-heading">
            <p class="eyebrow">{t.toolkit.eyebrow}</p>
            <h2>{t.toolkit.title}</h2>
          </div>
          <p class="section-intro">{t.toolkit.intro}</p>
        </div>

        <div class="capabilities">
          {capabilities.map((item) => <span>{item}</span>)}
        </div>
      </section>

      <section class="section faq-section">
        <div class="container faq-layout">
          <div class="section-heading">
            <p class="eyebrow">{t.faq.eyebrow}</p>
            <h2>{t.faq.title}</h2>
          </div>

          <div class="faq-list">
            {t.faq.items.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="section container">
        <div class="contact">
          <p class="eyebrow">{t.contact.eyebrow}</p>
          <h2>{t.contact.title}</h2>
          <p>{t.contact.text}</p>

          <ContactBrief lang={lang} />

          <div class="social-links">
            <a href="https://www.linkedin.com/in/mikdwo/" target="_blank" rel="noreferrer">LinkedIn</a>
            <a href={myAnalyzePublicUrl} target="_blank" rel="noreferrer">{t.contact.github}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="container">
      <div class="footer-brand">
        <div class="logo">MD<span>Quality</span></div>
        <p>© {new Date().getFullYear()} MD Quality · Mikołaj Dworak · {t.footer}</p>
      </div>
      <div class="footer-links">
        <a href={lang === "pl" ? "/pl/privacy/" : "/privacy/"}>
          {lang === "pl" ? "Polityka prywatności" : "Privacy"}
        </a>
        <a href={lang === "pl" ? "/pl/terms/" : "/terms/"}>
          {lang === "pl" ? "Warunki korzystania" : "Website terms"}
        </a>
      </div>
    </footer>

    <script is:inline>
      document.querySelectorAll("[data-lang]").forEach((link) => {
        link.addEventListener("click", () => {
          try {
            localStorage.setItem("mdq-lang", link.getAttribute("data-lang") || "en");
          } catch {}
        });
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 90px; }
  :global(body) {
    margin: 0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: radial-gradient(circle at 82% 6%, rgba(63, 142, 196, 0.14), transparent 28%), #080b10;
    color: #f5f7fa;
    line-height: 1.6;
  }
  :global(:focus-visible) { outline: 2px solid #7dd3fc; outline-offset: 4px; }
  :global(::selection) { background: #7dd3fc; color: #071019; }

  .container { width: min(1160px, calc(100% - 40px)); margin: 0 auto; }
  header {
    border-bottom: 1px solid rgba(35, 45, 58, 0.78);
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(8, 11, 16, 0.9);
    backdrop-filter: blur(18px);
  }
  nav { min-height: 72px; display: flex; align-items: center; gap: 22px; }
  .logo { flex: 0 0 auto; font-size: 21px; font-weight: 850; letter-spacing: -0.7px; text-decoration: none; color: white; }
  .logo span { color: #7dd3fc; }
  .nav-links { display: flex; align-items: center; justify-content: center; gap: 24px; margin-left: auto; }
  .nav-links a, .social-links a, .language-switch a { color: #9ba6b5; text-decoration: none; font-size: 13px; transition: color .2s ease; }
  .nav-links a:hover, .social-links a:hover, .language-switch a:hover, .language-switch a.active { color: white; }
  .language-switch { display: flex; align-items: center; gap: 6px; color: #465569; font-size: 12px; white-space: nowrap; }
  .language-switch a { font-weight: 800; }
  .header-cta { flex: 0 0 auto; text-decoration: none; color: #071019; background: #f4f7fb; border-radius: 8px; padding: 9px 14px; font-size: 12px; font-weight: 800; }

  .hero { min-height: 620px; display: grid; grid-template-columns: minmax(0, 1.42fr) minmax(310px, .58fr); gap: 55px; align-items: center; padding: 65px 0; }
  .badge, .panel-label, .eyebrow, .project-label, .best-for > span, .outcomes > span, .project-proof > span {
    color: #7dd3fc; font-size: 10px; letter-spacing: 1.7px; font-weight: 850;
  }
  .badge { display: inline-flex; padding: 7px 12px; border: 1px solid #263241; border-radius: 999px; margin-bottom: 28px; background: rgba(15,22,31,.72); }
  h1 { max-width: 920px; margin: 0; font-size: clamp(44px, 5.3vw, 66px); line-height: 1.08; letter-spacing: -2.6px; }
  h1 span { display: block; color: #7dd3fc; }
  h2 { font-size: clamp(36px, 5vw, 56px); line-height: 1.06; letter-spacing: -2.4px; margin: 8px 0 20px; }
  .hero-text { max-width: 770px; margin: 30px 0; font-size: 19px; color: #aeb7c4; }
  .hero-buttons, .contact-actions, .project-actions { display: flex; gap: 11px; flex-wrap: wrap; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 12px 19px; border-radius: 8px; text-decoration: none; font-weight: 780; font-size: 14px; transition: transform .2s ease, border-color .2s ease, background .2s ease; }
  .primary { background: #f4f7fb; color: #090c11; }
  .primary:hover { transform: translateY(-2px); }
  .secondary { color: white; border: 1px solid #2a3442; background: rgba(255,255,255,.01); }
  .secondary:hover { border-color: #506176; background: rgba(255,255,255,.035); }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 26px; color: #6f7d8f; font-size: 12px; }
  .hero-meta span { position: relative; }
  .hero-meta span:not(:last-child)::after { content: "·"; position: absolute; right: -11px; color: #415064; }
  .hero-panel { border: 1px solid #1d2835; border-radius: 18px; padding: 28px; background: radial-gradient(circle at 100% 0%, rgba(77,163,218,.09), transparent 40%), rgba(12,17,24,.92); }
  .need-list { margin-top: 18px; }
  .need-list > div { padding: 17px 0; border-top: 1px solid #1b2430; }
  .need-list > div:first-child { border-top: 0; }
  .need-list strong { display: block; font-size: 15px; margin-bottom: 4px; }
  .need-list span { display: block; color: #8290a1; font-size: 12px; line-height: 1.5; }

  .proof-strip { border-top: 1px solid #171d26; border-bottom: 1px solid #171d26; background: rgba(10,14,20,.62); }
  .proof-grid { display: grid; grid-template-columns: repeat(4,1fr); }
  .proof-grid > div { padding: 24px 22px; border-left: 1px solid #171d26; }
  .proof-grid > div:last-child { border-right: 1px solid #171d26; }
  .proof-grid strong { display: block; font-size: 14px; margin-bottom: 3px; }
  .proof-grid span { display: block; color: #718094; font-size: 11px; line-height: 1.4; }

  .section { padding: 108px 0; border-top: 1px solid #171d26; }
  .section-heading { max-width: 790px; margin-bottom: 48px; }
  .section-intro { max-width: 740px; color: #99a6b6; font-size: 16px; margin: 18px 0 0; }
  .section-split { display: grid; grid-template-columns: minmax(0,1fr) minmax(320px,.78fr); gap: 70px; align-items: end; margin-bottom: 48px; }
  .section-split .section-heading { margin-bottom: 0; }
  .section-split .section-intro { margin: 0 0 5px; }

  .quick-review-section { padding-top: 86px; padding-bottom: 86px; }
  .quick-review { display: grid; grid-template-columns: minmax(0,.95fr) minmax(420px,1.05fr); gap: 58px; align-items: center; padding: 42px; border: 1px solid #27384a; border-radius: 20px; background: radial-gradient(circle at 95% 5%, rgba(78,166,222,.11), transparent 35%), #0b1118; }
  .quick-review-copy .section-intro { margin-bottom: 0; }
  .quick-review-actions { margin-top: 28px; }
  .quick-review-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .quick-review-grid article { padding: 20px; border: 1px solid #1e2a37; border-radius: 13px; background: rgba(7,10,14,.55); }
  .quick-review-grid span { display: block; color: #7dd3fc; font-size: 10px; font-weight: 850; margin-bottom: 22px; }
  .quick-review-grid strong { display: block; margin-bottom: 6px; font-size: 15px; }
  .quick-review-grid p { margin: 0; color: #8492a4; font-size: 12px; }

