        "Development wspierany AI",
      ]
    : [
        "Functional & Exploratory Testing",
        "Release & Regression Testing",
        "REST APIs",
        "Postman",
        "PostgreSQL",
        "JSON",
        "Application Monitoring",
        "Troubleshooting",
        "JavaScript",
        "TypeScript",
        "GitHub",
        "GitLab",
        "Jira",
        "Technical Documentation",
