  { title: lang === "pl" ? "Dashboard na telefonie · tryb ciemny" : "Mobile dashboard · dark mode", src: "/images/myanalyze/4.1.0/mobile-dashboard.png", width: 1179, height: 2556 },
  { title: lang === "pl" ? "Kalendarz transakcji na telefonie" : "Mobile transaction calendar", src: "/images/myanalyze/4.1.0/mobile-calendar.png", width: 1179, height: 2556 },
  { title: lang === "pl" ? "Inwestycje na telefonie" : "Mobile investments", src: "/images/myanalyze/4.1.0/mobile-investments.png", width: 1179, height: 2556 },
