];

const capabilities =
  lang === "pl"
    ? [
        "Testy funkcjonalne i eksploracyjne",
        "Testy przed wdrożeniem i regresja",
        "REST API",
        "Postman",
        "PostgreSQL",
        "JSON",
        "Monitoring aplikacji",
        "Troubleshooting",
