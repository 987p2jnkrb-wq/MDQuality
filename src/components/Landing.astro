    : "mailto:mikolajdworak@icloud.com?subject=Quick%20QA%20review%20%2F%20service%20quote&body=Hi%20Miko%C5%82aj%2C%0A%0AWebsite%20or%20application%3A%0AWhat%20you%20want%20reviewed%3A%0ATarget%20date%3A%0AUseful%20links%20or%20context%3A%0A";

