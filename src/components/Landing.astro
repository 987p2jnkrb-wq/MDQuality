const pageDescription = isHome ? pageCopy.text : isOffer ? pageCopy.offerText : (lang === "pl" ? "Mikołaj Dworak - w IT od 2020 roku. Wsparcie aplikacji, testowanie, diagnostyka i własny projekt MyAnalyze." : "Mikołaj Dworak - working in IT since 2020. Application support, testing, diagnostics and the MyAnalyze personal project.");
