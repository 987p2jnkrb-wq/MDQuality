---
interface Props { lang: string; }
const { lang } = Astro.props;
const pl = lang === "pl";
const projectTags = pl
  ? ["Rozwój produktu", "Od pomysłu do wydania", "QA i regresja", "React / TypeScript", "Windows + mobile", "Development wspierany AI"]
  : ["Product development", "Idea to release", "QA & regression", "React / TypeScript", "Windows + mobile", "AI-assisted development"];
const stageIcons = [
  "M3 21V9l6 3V8l6 3V3h5v18H3ZM7 16h1m3 0h1m3 0h1",
  "M7 18a5 5 0 1 1 1-10 6 6 0 0 1 11 3 4 4 0 0 1-1 7H7Z",
  "M3 4h18v12H3ZM8 21h8m-4-5v5",
  "m3 8 9-5 9 5H3Zm2 3v7m5-7v7m4-7v7m5-7v7M3 21h18",
];
const text = pl ? {
  label: "DOŚWIADCZENIE ZAWODOWE",
  role: "Wsparcie aplikacji · QA · diagnostyka techniczna",
  intro: "Łączę wsparcie aplikacji z testowaniem i diagnostyką. Pracuję blisko użytkowników i zespołu technicznego: od odtworzenia problemu i analizy danych lub API po testy, dokumentację i drobne poprawki kodu. W IT pracuję od 2020 roku.",
  profileLabels: ["6+ lat w IT", "Application Support", "QA / Testing", "SQL + API", "Troubleshooting", "Klient + zespół techniczny"],
  contact: "Kontakt w sprawie pracy",
  history: "Doświadczenie w skrócie",
  approachTitle: "Współpraca i rozwój",
  approach: [
    "Potrafię rozmawiać o problemie zarówno z użytkownikiem, jak i z zespołem technicznym. Wyjaśniam ustalenia prostym językiem i dbam o to, żebyśmy wiedzieli, co robimy dalej.",
    "Nowe narzędzia poznaję przy konkretnych zadaniach. Dostosowuję sposób pracy do problemu i rozwijam umiejętności wraz ze zmianami technologii.",
    "W pracy łączę samodzielną diagnostykę ze współpracą z innymi. Uzgadniam potrzeby, proponuję zmiany i sprawdzam, czy rozwiązują problem użytkownika.",
  ],
  stages: [
    { period: "2023 - obecnie", title: "Wsparcie aplikacji i QA · produkcja / WMS", labels: ["Application Support", "QA", "WMS / produkcja", "API", "SQL", "TypeScript", "Praca z klientem"], points: ["Projektowanie zmian w systemach fabrycznych i WMS, propozycje implementacji i drobne poprawki w TypeScript.", "Testy aplikacji i API w Postmanie, praca z JSON, testy wydajnościowe i jednostkowe.", "Diagnozowanie zgłoszeń, wsparcie klientów i dokumentacja; praca z SQL, Jirą oraz repozytoriami GitLab i GitHub."] },
    { period: "2021 - 2023", title: "Application Support · web / mobile / desktop", labels: ["Application Support", "Odtwarzanie błędów", "Testowanie", "SQL", "Logi", "Wsparcie użytkowników"], description: "Diagnozowałem zgłoszenia, odtwarzałem błędy i testowałem aplikacje webowe, mobilne oraz desktopowe. Pracowałem z SQL i logami, wspierałem użytkowników oraz współpracowałem przy rozwoju aplikacji." },
    { period: "2020", title: "IT Support · użytkownicy i endpointy", labels: ["IT Support", "Troubleshooting", "Endpoint security", "Sprzęt i oprogramowanie"], description: "Zajmowałem się serwisem sprzętu, instalacją i aktualizacją oprogramowania oraz rozwiązywaniem problemów z urządzeniami i usługami. Analizowałem logi i reagowałem na alerty ochrony stacji roboczych." },
    { period: "Wcześniejsze doświadczenie", title: "Bankowość · obsługa klienta i zarządzanie zespołem", labels: ["Zarządzanie zespołem", "Obsługa klienta", "Bankowość", "Procedury i bezpieczeństwo"], description: "Obsługiwałem klientów i pracowałem w aplikacjach bankowych, zgodnie z procedurami i zasadami bezpieczeństwa. Przez rok zarządzałem zespołem. Poznałem pracę z produktami bankowymi i odpowiedzialność za poprawną obsługę klienta." },
  ],
  projectLabel: "WŁASNY PROJEKT",
  projectTitle: "MyAnalyze - od pomysłu do wydania",
  projectText: "Zbudowałem aplikację do finansów osobistych: od projektu interfejsu i logiki działania po implementację, testy, dokumentację i wydania. Wykorzystuję w niej doświadczenie z codziennej pracy przy aplikacjach.",
  resultsTitle: "Co można sprawdzić",
  results: [
    "Opublikowana wersja 4.0 z instalatorem Windows i interfejsem mobilnym w PL i EN.",
    "Import CSV/PDF, historia transakcji, konta, cele i prognozy w jednym produkcie.",
    "Testy UI i API, regresja na tymczasowych bazach SQLite oraz build i testy w CI.",
  ],
  projectMethod: "AI wykorzystuję do projektowania, kodowania i diagnostyki. Sam ustalam zakres zmian i sprawdzam ich działanie.",
  projectLink: "Aplikacja i wydania",
  evidence: "Historia rozwoju i przykłady",
} : {
  label: "PROFESSIONAL EXPERIENCE",
  role: "Application Support · QA · Technical Troubleshooting",
  intro: "I combine application support, QA and technical troubleshooting. I work with users and developers to reproduce issues, investigate data and APIs, test changes and document findings. I also contribute focused code fixes.",
  profileLabels: ["6+ years in IT", "Application Support", "QA / Testing", "SQL + API", "Troubleshooting", "Customer & developer collaboration"],
  contact: "Contact me about a role",
  history: "Experience at a glance",
  approachTitle: "How I work with teams",
  approach: [
    "I explain technical problems in plain language so users and developers understand the findings and next steps.",
    "I investigate independently, collaborate when needed and check whether the proposed fix solves the user's problem.",
    "I learn new tools through real tasks and choose them based on the problem, not the trend.",
  ],
  stages: [
    { period: "2023 - present", title: "Application Support & QA · manufacturing / WMS", labels: ["Application Support", "QA", "WMS / manufacturing", "API", "SQL", "TypeScript", "Customer-facing"], points: ["I help plan changes to manufacturing and WMS applications, propose implementation approaches and make focused TypeScript fixes.", "I test applications and APIs with Postman, work with JSON and take part in unit and performance testing.", "I investigate customer-reported issues, check data with SQL and document findings in Jira while working with GitLab and GitHub."] },
    { period: "2021 - 2023", title: "Application Support · web / mobile / desktop", labels: ["Application Support", "Bug reproduction", "Testing", "SQL", "Logs", "User support"], description: "I investigated support requests, reproduced issues and tested web, mobile and desktop applications. I worked with SQL and logs, supported users and contributed to application development." },
    { period: "2020", title: "IT Support · users and endpoints", labels: ["IT Support", "Troubleshooting", "Endpoint security", "Hardware & software"], description: "I serviced hardware, installed and updated software, and resolved device and service issues. I investigated logs and responded to endpoint protection alerts." },
    { period: "Earlier experience", title: "Banking · customer service and team leadership", labels: ["Team leadership", "Customer service", "Banking", "Procedures & security"], description: "I supported customers using banking applications and followed security procedures. I also managed a team for one year, gaining experience in customer service and team leadership." },
  ],
  projectLabel: "PERSONAL PROJECT",
  projectTitle: "MyAnalyze - from idea to release",
  projectText: "I built MyAnalyze from idea to release, covering interface design, application logic, development, testing and documentation.",
  resultsTitle: "What you can review",
  results: [
    "Published version 4.0 with a Windows installer, mobile interface, and Polish and English UI.",
    "CSV/PDF imports, transaction history, accounts, goals and forecasts in one product.",
    "UI and API tests, regression testing with temporary SQLite databases, and automated builds and tests in CI.",
  ],
  projectMethod: "I use AI for design, coding and diagnostics. I decide the scope of changes and verify how they work.",
  projectLink: "Application and releases",
  evidence: "Development history and examples",
};
---

<section id="about" class="experience" aria-labelledby="experience-name">
  <div class="profile">
    <p class="eyebrow">{text.label}</p>
    <h1 id="experience-name">Mikołaj Dworak</h1>
    <p class="role">{text.role}</p>
    <p class="intro">{text.intro}</p>
    <ul class="profile-labels" aria-label={pl ? "Najważniejsze obszary doświadczenia" : "Core experience areas"}>{text.profileLabels.map((item) => <li>{item}</li>)}</ul>
    <div class="contact-links">
      <a href="mailto:mikolajdworak@icloud.com">{text.contact} <span aria-hidden="true">→</span></a>
      <a href="https://www.linkedin.com/in/mikdwo/" target="_blank" rel="noreferrer">LinkedIn</a>
    </div>
  </div>
  <div class="experience-body">
    <section aria-labelledby="career-title">
      <h2 id="career-title">{text.history}</h2>
      <ol class="timeline">
        {text.stages.map((stage, index) => <li>
          <svg class="stage-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={stageIcons[index]} /></svg>
          <p class="period">{stage.period}</p>
          <h3>{stage.title}</h3>
          {stage.labels && <ul class="skill-labels" aria-label={pl ? "Obszary, umiejętności i narzędzia" : "Areas, skills and tools"}>{stage.labels.map((item) => <li>{item}</li>)}</ul>}
          {stage.points ? <ul class="stage-points">{stage.points.map((point) => <li>{point}</li>)}</ul> : <p>{stage.description}</p>}
        </li>)}
      </ol>
    </section>
    <section class="project" aria-labelledby="personal-project-title">
      <p class="eyebrow">{text.projectLabel}</p>
      <h2 id="personal-project-title">{text.projectTitle}</h2>
      <ul class="skill-labels project-technologies" aria-label={pl ? "Najważniejsze obszary projektu" : "Key project areas"}>{projectTags.map((item) => <li>{item}</li>)}</ul>
      <p>{text.projectText}</p>
      <h3 class="results-title">{text.resultsTitle}</h3>
      <ul class="results">{text.results.map((result) => <li>{result}</li>)}</ul>
      <p>{text.projectMethod}</p>
      <div class="project-links">
        <a class="project-button" href="https://github.com/987p2jnkrb-wq/MyAnalyze-releases" target="_blank" rel="noreferrer">{text.projectLink} <span aria-hidden="true">↗</span></a>
        <a href={pl ? "/pl/#work" : "/#work"}>{text.evidence}</a>
      </div>
    </section>
  </div>
  <section class="approach" aria-labelledby="approach-title">
    <h2 id="approach-title">{text.approachTitle}</h2>
    <ul>{text.approach.map((item) => <li>{item}</li>)}</ul>
  </section>
</section>

<style>
  .experience { width: min(1160px, calc(100% - 40px)); margin: 0 auto; padding: 48px 0; }
  .profile { max-width: 780px; margin-bottom: 38px; }
  .eyebrow { color: #7dd3fc; font-size: 10px; letter-spacing: 1.7px; font-weight: 850; margin: 0 0 12px; }
  h1 { font-size: clamp(32px, 5vw, 48px); line-height: 1.1; letter-spacing: -1.5px; margin: 0 0 14px; }
  .role { color: #dce6f0; font-size: 19px; margin: 0 0 16px; }
  .intro { color: #aeb7c4; font-size: 16px; margin: 0; }
  .profile-labels, .skill-labels { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; }
  .profile-labels { margin: 18px 0 0; }
  .profile-labels li { padding: 5px 10px; border: 1px solid #30465e; border-radius: 999px; background: rgba(16,27,40,.72); color: #d8e8f5; font-size: 12px; line-height: 1.4; }
  .contact-links, .project-links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 22px; }
  a { color: #7dd3fc; font-size: 14px; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .experience-body { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .9fr); gap: 40px; align-items: start; }
  .approach { max-width: 860px; margin-top: 36px; padding-top: 24px; border-top: 1px solid #27384a; }
  .approach h2 { font-size: 19px; margin-bottom: 12px; }
  .approach ul { margin: 0; padding-left: 18px; color: #aeb7c4; font-size: 14px; }
  .approach li + li { margin-top: 8px; }
  .skill-labels { margin: 10px 0 14px; }
  .skill-labels li { padding: 3px 9px; border: 1px solid #30465e; border-radius: 6px; background: #101b28; color: #c7dcef; font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
  h2 { font-size: 23px; line-height: 1.25; letter-spacing: -.5px; margin: 0 0 22px; }
  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline > li { border-left: 1px solid #2a3b4f; padding: 0 0 25px 22px; position: relative; }
  .timeline > li:last-child { padding-bottom: 0; }
  .stage-points { padding-left: 17px; margin: 0; color: #aeb7c4; font-size: 14px; }
  .stage-points li + li { margin-top: 7px; }
  .stage-icon { position: absolute; left: -10px; top: 28px; color: #7dd3fc; background: #080b10; }
  .period { font-size: 12px; color: #7dd3fc; margin: 0 0 6px; }
  h3 { font-size: 17px; line-height: 1.4; margin: 0 0 8px; }
  li > p:last-child, .project > p:not(.eyebrow) { font-size: 14px; color: #aeb7c4; margin: 0; }
  .project { padding: 26px; background: #0d131c; border: 1px solid #27384a; border-radius: 16px; }
  .project h2 { margin-bottom: 16px; }
  .project > p:not(.eyebrow) + p { margin-top: 14px; }
  .results-title { margin-top: 20px; font-size: 14px; }
  .results { padding-left: 18px; margin: 0 0 18px; color: #aeb7c4; font-size: 14px; }
  .results li + li { margin-top: 8px; }
  .project-button { display: inline-flex; align-items: center; gap: 8px; padding: 11px 15px; border: 1px solid #385572; border-radius: 8px; color: #e8f5ff; background: #162638; }
  @media (max-width: 820px) { .experience-body { grid-template-columns: 1fr; gap: 30px; } }
  @media (max-width: 520px) { .experience { width: calc(100% - 30px); padding: 30px 0; } .role { font-size: 17px; } .profile { margin-bottom: 30px; } .project { padding: 22px; } }
</style>
