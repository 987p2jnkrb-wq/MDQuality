---
interface Props {
  id: string;
  lang: string;
  versions: { version: string }[];
}
const { id, lang, versions } = Astro.props;
const pl = lang === "pl";
const trackId = `${id}-track`;
---

<section class="version-carousel" data-version-carousel aria-label={pl ? "IleZostaje — produkt i historia rozwoju" : "IleZostaje product and release history"} aria-roledescription={pl ? "karuzela" : "carousel"}>
  <div class="version-heading">
    <p>{pl ? "IleZostaje · produkt i rozwój" : "IleZostaje · product and evolution"}</p>
    <span>{pl ? "Dalej: wcześniejsze etapy projektu" : "Next: earlier product milestones"}</span>
  </div>
  <div class="version-track" id={trackId} data-version-track role="group" tabindex="0" aria-label={pl ? "Wersje projektu" : "Project versions"}>
    <slot />
  </div>
  <div class="version-controls">
    <button class="version-arrow" type="button" data-version-previous aria-label={pl ? "Poprzedni slajd" : "Previous slide"} aria-controls={trackId} disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <div class="version-picker" aria-label={pl ? "Wybierz wersję" : "Choose a version"}>
      {versions.map((item, index) => <button type="button" data-version-index={index} data-version-number={item.version} aria-label={`${pl ? "Pokaż wersję" : "Show version"} ${item.version}`} aria-current={index === 0 ? "true" : undefined} aria-controls={trackId}><span class="version-dot" aria-hidden="true"></span></button>)}
    </div>
    <button class="version-arrow" type="button" data-version-next aria-label={pl ? "Następny slajd" : "Next slide"} aria-controls={trackId}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <span class="version-count" aria-hidden="true" data-version-count>01 / {String(versions.length).padStart(2, "0")}</span>
    <span class="sr-only" data-version-status aria-live="polite" aria-atomic="true" data-version-prefix={pl ? "Wersja" : "Version"}>{pl ? "Wersja" : "Version"} {versions[0].version}</span>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-version-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-version-track]");
    const status = root.querySelector<HTMLElement>("[data-version-status]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-version-index]")];
    const previous = root.querySelector<HTMLButtonElement>("[data-version-previous]");
    const next = root.querySelector<HTMLButtonElement>("[data-version-next]");
    const counter = root.querySelector<HTMLElement>("[data-version-count]");
    if (!track || !status) return;
    const slides = [...track.children].filter((child): child is HTMLElement => child instanceof HTMLElement);
    let active = 0;
    let scheduled = false;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const syncHeight = () => {
      const height = Math.ceil(slides[active]?.getBoundingClientRect().height ?? 0);
      if (height > 0 && track.style.height !== `${height}px`) track.style.height = `${height}px`;
    };
    const update = (index: number) => {
      active = index;
      buttons.forEach((button, position) => {
        if (position === index) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
      });
      slides.forEach((slide, position) => { slide.inert = position !== index; });
      status.textContent = `${status.dataset.versionPrefix} ${buttons[index].dataset.versionNumber}`;
      if (previous) previous.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
      if (counter) counter.textContent = `${String(index + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
      syncHeight();
    };
    const show = (index: number, animate = true) => {
      const selected = Math.max(0, Math.min(slides.length - 1, index));
      track.scrollTo({ left: slides[selected].offsetLeft, behavior: animate && !reducedMotion.matches ? "smooth" : "instant" });
    };
    buttons.forEach((button, index) => button.addEventListener("click", () => show(index)));
    previous?.addEventListener("click", () => show(active - 1));
    next?.addEventListener("click", () => show(active + 1));
    track.addEventListener("keydown", (event) => {
      if (event.target !== track) return;
      const requested = event.key === "ArrowRight" ? active + 1 : event.key === "ArrowLeft" ? active - 1 : event.key === "Home" ? 0 : event.key === "End" ? slides.length - 1 : null;
      if (requested !== null) { event.preventDefault(); show(requested); }
    });
    track.addEventListener("scroll", () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => {
        scheduled = false;
        let nearest = 0;
        slides.forEach((slide, index) => {
          if (Math.abs(slide.offsetLeft - track.scrollLeft) < Math.abs(slides[nearest].offsetLeft - track.scrollLeft)) nearest = index;
        });
        if (nearest !== active) update(nearest);
      });
    }, { passive: true });
    new ResizeObserver(() => show(active, false)).observe(track);
    const slideObserver = new ResizeObserver(syncHeight);
    slides.forEach(slide => slideObserver.observe(slide));
    update(0);
  });
</script>

<style>
  .version-carousel { min-width: 0; }
  .version-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; margin-bottom: 14px; }
  .version-heading p { margin: 0; color: #c3d3e5; font-size: 13px; font-weight: 700; }
  .version-heading span { color: #8996a6; font-size: 12px; }
  .version-track { position: relative; display: grid; grid-auto-flow: column; grid-auto-columns: 100%; align-items: start; gap: 16px; min-width: 0; overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .version-track > :global(*) { min-width: 0; scroll-snap-align: start; scroll-snap-stop: always; }
  .version-track::-webkit-scrollbar { display: none; }
  .version-controls { display: flex; justify-content: center; align-items: center; gap: 5px; margin-top: 9px; }
  .version-arrow { width: 35px; height: 35px; border: 1px solid #33445b; border-radius: 9px; color: #cfe4f4; background: #121c29; }
  .version-arrow svg { width: 17px; height: 17px; }
  .version-arrow:hover:not(:disabled) { background: #1b2b3d; border-color: #6195bb; }
  .version-arrow:disabled { opacity: .33; cursor: default; }
  .version-count { min-width: 57px; text-align: right; color: #8397ad; font-size: 11px; font-variant-numeric: tabular-nums; }
  .version-picker { display: flex; gap: 0; }
  button { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 0; padding: 0; background: transparent; cursor: pointer; border-radius: 50%; }
  .version-dot { width: 7px; height: 7px; background: #465569; border-radius: 50%; transition: background .15s ease, transform .15s ease; }
  button[aria-current="true"] .version-dot { background: #7dd3fc; transform: scale(1.2); }
  button:hover .version-dot { background: #c6eaff; }
  button:focus-visible, .version-track:focus-visible { outline: 2px solid #7dd3fc; outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 600px) { .version-heading span { max-width: 220px; } }
  @media (prefers-reduced-motion: reduce) { .version-dot { transition: none; } }
</style>
