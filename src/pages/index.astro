---
const primaryServices = [
  {
    number: "01",
    title: "QA & Release Testing",
    summary:
      "Focused testing before release, during regression or when product risk is unclear.",
    bestFor:
      "Teams preparing a release, inheriting an unstable product or needing an independent quality check.",
    outcomes: [
      "Risk-based test scope and prioritized coverage",
      "Functional, exploratory, API and database checks",
      "Clear defect reports with reproduction steps and evidence",
      "Release-readiness summary with open risks and recommended next actions",
    ],
  },
  {
    number: "02",
    title: "Test & Business Automation",
    summary:
      "Turn repeatable manual work into checks and workflows that can be run consistently.",
    bestFor:
      "Repeated regression work, recurring operational tasks and processes that depend too much on manual steps.",
    outcomes: [
      "Automation opportunities identified and prioritized",
      "Reusable scripts, checks or workflow automations",
      "Clear configuration and run instructions",
      "Handover notes so the solution can be maintained and repeated",
    ],
  },
  {
    number: "03",
    title: "Application Support & Troubleshooting",
    summary:
      "Structured investigation of application, integration and data-flow problems.",
    bestFor:
      "Production issues, difficult-to-reproduce bugs, integration failures and recurring support problems.",
    outcomes: [
      "Reproduction and evidence gathering",
      "Log, API and data-flow investigation",
      "Root-cause notes or a narrowed technical hypothesis",
      "Fix verification, documentation and next-step recommendations",
    ],
  },
];

const secondaryServices = [
  {
    title: "API & Integration Validation",
    text:
      "Validate requests, responses, edge cases and data flows between services before they become production incidents.",
  },
  {
    title: "Web Applications & Internal Tools",
    text:
      "Focused MVPs, internal tools and practical web applications when the best solution is to build, not only test.",
  },
];

const deliverables = [
  {
    title: "Release Readiness Report",
    text:
      "Scope, executed checks, prioritized findings, known risks and a concise release recommendation.",
  },
  {
    title: "Automation Handover",
    text:
      "Reusable scripts or workflows with setup instructions, assumptions and a clear way to run them again.",
  },
  {
    title: "Troubleshooting Summary",
    text:
      "Evidence, reproduction path, observations, likely cause, fix verification and recommended next actions.",
  },
];

const processSteps = [
  {
    number: "01",
    title: "Brief",
    text:
      "You describe the product, problem, release or repetitive process and share the context that is safe to provide.",
  },
  {
    number: "02",
    title: "Scope & quote",
    text:
      "You receive a proposed scope, expected deliverables and a clear estimate before work starts.",
  },
  {
    number: "03",
    title: "Delivery",
    text:
      "Testing, investigation or automation is completed with concise progress updates and evidence where useful.",
  },
  {
    number: "04",
    title: "Handover",
    text:
      "You receive the agreed report, documentation, scripts or working solution together with practical next steps.",
  },
];

const projectScreens = [
  {
    title: "MyAnalyze dashboard",
    src: "https://github.com/987p2jnkrb-wq/MyAnalyze-releases/releases/download/v2.0.0/screenshots.release.png",
  },
  {
    title: "Finance Manager",
    src: "https://github.com/987p2jnkrb-wq/MyAnalyze-releases/releases/download/v2.0.0/screenshots.release2.png",
  },
  {
    title: "Financial analysis",
    src: "https://github.com/987p2jnkrb-wq/MyAnalyze-releases/releases/download/v2.0.0/screenshots.release.3.png",
  },
  {
    title: "Application overview",
    src: "https://github.com/987p2jnkrb-wq/MyAnalyze-releases/releases/download/v2.0.0/screenshots.release.4.png",
  },
];

const capabilities = [
  "Functional & Exploratory Testing",
  "Release & Regression Testing",
  "REST APIs",
  "Postman",
  "PostgreSQL",
  "JSON",
  "Application Monitoring",
  "Troubleshooting",
  "JavaScript",
  "TypeScript",
  "GitHub",
  "GitLab",
  "Jira",
  "Technical Documentation",
  "AI-assisted Development",
];

const myAnalyzePublicUrl =
  "https://github.com/987p2jnkrb-wq/MyAnalyze-releases";
const myAnalyzeReleaseUrl =
  "https://github.com/987p2jnkrb-wq/MyAnalyze-releases/releases/tag/v2.0.0";
const quoteMailto =
  "mailto:hello@mdquality.pl?subject=QA%20%2F%20Automation%20quote&body=Hi%20Miko%C5%82aj%2C%0A%0AProject%20or%20product%3A%0AWhat%20you%20need%20help%20with%3A%0ATimeline%3A%0AUseful%20links%20or%20context%3A%0A";

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "MD Quality",
  url: "https://mdquality.pl/",
  email: "hello@mdquality.pl",
  description:
    "B2B software testing, automation and application support services for product teams and businesses.",
  founder: {
    "@type": "Person",
    name: "Mikołaj Dworak",
  },
  sameAs: [
    "https://www.linkedin.com/in/mikdwo/",
    "https://github.com/987p2jnkrb-wq/MyAnalyze-releases",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#080b10" />

    <title>MD Quality | B2B Software Testing, Automation & Application Support</title>

    <meta
      name="description"
      content="B2B software testing, automation and application support. Release testing, troubleshooting, API validation, process automation and focused technical delivery."
    />
    <link rel="canonical" href="https://mdquality.pl/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="MD Quality | Software Testing, Automation & Application Support" />
    <meta
      property="og:description"
      content="Practical B2B QA, automation and application support focused on clearer releases, faster diagnostics and repeatable workflows."
    />
    <meta property="og:url" content="https://mdquality.pl/" />
    <meta property="og:site_name" content="MD Quality" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="MD Quality | Software Testing, Automation & Application Support" />
    <meta
      name="twitter:description"
      content="Practical B2B QA, automation and application support focused on clearer releases, faster diagnostics and repeatable workflows."
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </head>

  <body>
    <header>
      <nav class="container" aria-label="Primary navigation">
        <a class="logo" href="/" aria-label="MD Quality home">MD<span>Quality</span></a>

        <div class="nav-links">
          <a href="#services">Services</a>
          <a href="#deliverables">Deliverables</a>
          <a href="#process">Process</a>
          <a href="#work">Work</a>
          <a href="#about">About</a>
        </div>

        <a class="header-cta" href={quoteMailto}>Request a quote</a>
      </nav>
    </header>

    <main>
      <section class="hero container">
        <div class="hero-copy">
          <div class="badge">B2B SOFTWARE QUALITY & TECHNICAL SUPPORT</div>

          <h1>
            Software testing, automation & application support
            <span>for businesses.</span>
          </h1>

          <p class="hero-text">
            I help product teams and businesses release software with more confidence,
            reduce repetitive manual work and resolve technical issues faster.
            Project-based or ongoing support, with a clear scope and practical handover.
          </p>

          <div class="hero-buttons">
            <a class="button primary" href={quoteMailto}>Request a QA / Automation Quote</a>
            <a class="button secondary" href="#services">Explore services</a>
          </div>

          <div class="hero-meta" aria-label="Engagement highlights">
            <span>6+ years in software quality & support</span>
            <span>Project-based or ongoing</span>
            <span>PL / EN</span>
          </div>
        </div>

        <aside class="hero-panel" aria-label="Common engagement needs">
          <p class="panel-label">A GOOD FIT WHEN YOU NEED TO</p>

          <div class="need-list">
            <div>
              <strong>Release with fewer unknowns</strong>
              <span>Independent checks before production or an important handover.</span>
            </div>
            <div>
              <strong>Reduce repetitive work</strong>
              <span>Turn repeated manual checks or processes into reusable automation.</span>
            </div>
            <div>
              <strong>Diagnose a difficult issue</strong>
              <span>Structure the investigation across application, API, logs and data.</span>
            </div>
            <div>
              <strong>Add technical capacity</strong>
              <span>Bring in focused QA or support help without building a permanent team first.</span>
            </div>
          </div>
        </aside>
      </section>

      <section class="proof-strip" aria-label="Core capabilities">
        <div class="container proof-grid">
          <div>
            <strong>QA + Release</strong>
            <span>risk-focused coverage and actionable findings</span>
          </div>
          <div>
            <strong>Automation</strong>
            <span>repeatable checks and practical workflows</span>
          </div>
          <div>
            <strong>Support + Diagnostics</strong>
            <span>structured investigation and clear evidence</span>
          </div>
          <div>
            <strong>API + Data</strong>
            <span>integration validation and data-flow checks</span>
          </div>
        </div>
      </section>

      <section id="services" class="section container">
        <div class="section-heading">
          <p class="eyebrow">CORE B2B SERVICES</p>
          <h2>Three focused ways to improve software delivery.</h2>
          <p class="section-intro">
            The offer is intentionally centered on quality, automation and technical
            support. Each engagement starts with a defined problem and ends with
            something your team can use.
          </p>
        </div>

        <div class="services-grid">
          {
            primaryServices.map((service) => (
              <article class="service-card">
                <span class="card-number">{service.number}</span>
                <h3>{service.title}</h3>
                <p class="service-summary">{service.summary}</p>

                <div class="best-for">
                  <span>BEST FOR</span>
                  <p>{service.bestFor}</p>
                </div>

                <div class="outcomes">
                  <span>YOU GET</span>
                  <ul>
                    {service.outcomes.map((outcome) => <li>{outcome}</li>)}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>

        <div class="secondary-services">
          <div class="secondary-heading">
            <p class="eyebrow">ADDITIONAL CAPABILITY</p>
            <h3>When the problem needs more than the core scope.</h3>
          </div>

          <div class="secondary-grid">
            {
              secondaryServices.map((service) => (
                <article>
                  <h4>{service.title}</h4>
                  <p>{service.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="deliverables" class="section container">
        <div class="section-split">
          <div class="section-heading">
            <p class="eyebrow">CLEAR OUTPUTS</p>
            <h2>Know what you are getting before the work starts.</h2>
          </div>

          <p class="section-intro">
            No vague "testing done" handoff. The output is agreed in advance and can
            include reports, evidence, scripts, documentation or a working technical
            solution.
          </p>
        </div>

        <div class="deliverables-grid">
          {
            deliverables.map((deliverable) => (
              <article class="deliverable-card">
                <div class="deliverable-icon" aria-hidden="true"></div>
                <h3>{deliverable.title}</h3>
                <p>{deliverable.text}</p>
              </article>
            ))
          }
        </div>

        <div class="sample-report">
          <div>
            <p class="project-label">DEMONSTRATION DELIVERABLE</p>
            <h3>See what a concise QA handover can look like.</h3>
            <p>
              A fictional sample shows the structure of a release-readiness report:
              scope, risks, findings, evidence and recommendation. It is clearly marked
              as a demonstration and contains no client data.
            </p>
          </div>

          <a class="button secondary" href="/sample-qa-report/">View sample QA report</a>
        </div>
      </section>

      <section id="process" class="section process-section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">HOW AN ENGAGEMENT WORKS</p>
            <h2>Simple from first message to handover.</h2>
            <p class="section-intro">
              The process is designed to make a small project easy to start without
              adding unnecessary meetings or process overhead.
            </p>
          </div>

          <div class="process-grid">
            {
              processSteps.map((step) => (
                <article class="process-step">
                  <span>{step.number}</span>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="work" class="section container">
        <div class="section-heading">
          <p class="eyebrow">SELECTED WORK</p>
          <h2>MyAnalyze 2.0.0</h2>
          <p class="section-intro">
            A real product project that combines application development, data-heavy
            workflows, QA and release management. The public repository contains
            releases, screenshots and release notes while the source code remains private.
          </p>
        </div>

        <article class="project">
          <div class="project-copy">
            <p class="project-label">PRODUCT CASE STUDY</p>

            <h3>Personal finance workspace for Windows</h3>

            <p>
              MyAnalyze is an offline-first desktop application for accounts,
              transactions, statement imports, forecasts, configurable KPIs,
              financial analysis, goals and local data storage.
            </p>

            <div class="project-proof">
              <div>
                <span>WHAT IT DEMONSTRATES</span>
                <ul>
                  <li>End-to-end product delivery from idea to packaged release</li>
                  <li>Complex local data flows and import workflows</li>
                  <li>Versioned releases, regression thinking and release notes</li>
                  <li>Practical UI, analytics and business-rule validation</li>
                </ul>
              </div>
            </div>

            <div class="tags">
              <span>React</span>
              <span>TypeScript</span>
              <span>Node.js</span>
              <span>SQLite</span>
              <span>Electron</span>
              <span>Jest</span>
            </div>

            <div class="project-actions">
              <a
                class="button secondary"
                href={myAnalyzePublicUrl}
                target="_blank"
                rel="noreferrer"
              >
                Public project page
              </a>
              <a
                class="button secondary"
                href={myAnalyzeReleaseUrl}
                target="_blank"
                rel="noreferrer"
              >
                Release 2.0.0
              </a>
            </div>
          </div>

          <a
            class="project-preview project-image-link"
            href={projectScreens[0].src}
            target="_blank"
            rel="noreferrer"
            aria-label="Open MyAnalyze 2.0.0 dashboard screenshot"
          >
            <img
              src={projectScreens[0].src}
              alt="MyAnalyze 2.0.0 dashboard interface"
              loading="lazy"
            />
          </a>
        </article>

        <div class="project-gallery" aria-label="MyAnalyze screenshots">
          {
            projectScreens.slice(1).map((screen) => (
              <a
                class="project-shot"
                href={screen.src}
                target="_blank"
                rel="noreferrer"
              >
                <img
                  src={screen.src}
                  alt={"MyAnalyze - " + screen.title}
                  loading="lazy"
                />
                <span>{screen.title}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section id="about" class="section container about-section">
        <div class="about-copy">
          <p class="eyebrow">ABOUT</p>

          <h2>Technical depth without agency overhead.</h2>

          <p class="about-lead">
            MD Quality is an independent software quality and technical support
            service run by Mikołaj Dworak.
          </p>

          <p>
            I have 6+ years of experience around business applications and software
            products, combining functional and pre-release testing, API and database
            testing, performance verification, application monitoring, technical
            support and troubleshooting.
          </p>

          <p>
            I have worked directly with developers, users and product environments
            to diagnose issues, document solutions and improve day-to-day operations.
            I also have experience leading a technical support team.
          </p>

          <p>
            Today that foundation extends into test automation, process automation,
            AI-assisted development and focused application delivery. Web applications
            and internal tools are available when they are the practical answer, but
            QA, automation and support remain the core offer.
          </p>
        </div>

        <aside class="about-panel">
          <p class="panel-label">WORKING PRINCIPLES</p>
          <ul>
            <li>Understand the real user flow before testing it</li>
            <li>Prioritize risks instead of producing noise</li>
            <li>Look for root causes, not only symptoms</li>
            <li>Document findings so another person can act on them</li>
            <li>Automate when repetition stops adding value</li>
          </ul>
        </aside>
      </section>

      <section class="section container">
        <div class="section-split toolkit-heading">
          <div class="section-heading">
            <p class="eyebrow">TOOLKIT</p>
            <h2>Tools and areas I work with.</h2>
          </div>

          <p class="section-intro">
            The exact stack depends on the project. The focus is on practical
            testing, diagnostics, integrations, data and lightweight automation.
          </p>
        </div>

        <div class="capabilities">
          {capabilities.map((capability) => <span>{capability}</span>)}
        </div>
      </section>

      <section class="section faq-section">
        <div class="container faq-layout">
          <div class="section-heading">
            <p class="eyebrow">FAQ</p>
            <h2>Before you send a brief.</h2>
          </div>

          <div class="faq-list">
            <details>
              <summary>Can this be a small one-off engagement?</summary>
              <p>
                Yes. A release check, investigation, automation task or focused QA
                review can be scoped as a standalone project.
              </p>
            </details>

            <details>
              <summary>Do you need full source-code access?</summary>
              <p>
                Not always. Depending on the task, work can start from a build, test
                environment, API documentation, logs, database access or a reproducible
                problem. The minimum useful access is agreed during scoping.
              </p>
            </details>

            <details>
              <summary>What will I receive at the end?</summary>
              <p>
                That is defined before work starts. Typical outputs include a QA
                report, prioritized findings, evidence, automation scripts,
                configuration, documentation or a troubleshooting summary.
              </p>
            </details>

            <details>
              <summary>Can you support ongoing releases or support work?</summary>
              <p>
                Yes. Ongoing cooperation can be arranged around recurring releases,
                regression work, application support or a defined technical backlog.
              </p>
            </details>
          </div>
        </div>
      </section>

      <section id="contact" class="section container">
        <div class="contact">
          <p class="eyebrow">REQUEST A QUOTE</p>

          <h2>Send the problem, release or process you want to improve.</h2>

          <p>
            A useful first message can be short: what the product is, what you need
            help with, your target date and any links or context you can safely share.
          </p>

          <div class="contact-points">
            <span>Product or application</span>
            <span>Desired outcome</span>
            <span>Timeline</span>
            <span>Useful context or constraints</span>
          </div>

          <div class="contact-actions">
            <a class="button primary" href={quoteMailto}>
              Request a QA / Automation Quote
            </a>
            <a class="button secondary" href="mailto:hello@mdquality.pl">
              hello@mdquality.pl
            </a>
            <a class="button secondary" href="mailto:mikolajdworak@icloud.com">
              mikolajdworak@icloud.com
            </a>
          </div>

          <div class="social-links">
            <a
              href="https://www.linkedin.com/in/mikdwo/"
              target="_blank"
              rel="noreferrer"
            >
              LinkedIn
            </a>
            <a
              href="https://github.com/987p2jnkrb-wq/MyAnalyze-releases"
              target="_blank"
              rel="noreferrer"
            >
              Public GitHub
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="container">
      <div class="logo">MD<span>Quality</span></div>
      <p>© {new Date().getFullYear()} MD Quality · Mikołaj Dworak</p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at 82% 6%, rgba(63, 142, 196, 0.14), transparent 28%),
      #080b10;
    color: #f5f7fa;
    line-height: 1.6;
  }

  :global(a:focus-visible),
  :global(summary:focus-visible) {
    outline: 2px solid #7dd3fc;
    outline-offset: 4px;
  }

  :global(::selection) {
    background: #7dd3fc;
    color: #071019;
  }

  .container {
    width: min(1160px, calc(100% - 40px));
    margin: 0 auto;
  }

  header {
    border-bottom: 1px solid rgba(35, 45, 58, 0.78);
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(8, 11, 16, 0.9);
    backdrop-filter: blur(18px);
  }

  nav {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    flex: 0 0 auto;
    font-size: 21px;
    font-weight: 850;
    letter-spacing: -0.7px;
    text-decoration: none;
    color: white;
  }

  .logo span {
    color: #7dd3fc;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
    margin-left: auto;
  }

  .nav-links a,
  .social-links a {
    color: #9ba6b5;
    text-decoration: none;
    font-size: 13px;
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .social-links a:hover {
    color: white;
  }

  .header-cta {
    flex: 0 0 auto;
    text-decoration: none;
    color: #071019;
    background: #f4f7fb;
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 12px;
    font-weight: 800;
  }

  .hero {
    min-height: 740px;
    display: grid;
    grid-template-columns: minmax(0, 1.42fr) minmax(310px, 0.58fr);
    gap: 72px;
    align-items: center;
    padding-top: 92px;
    padding-bottom: 92px;
  }

  .hero-copy {
    min-width: 0;
  }

  .badge {
    display: inline-flex;
    padding: 7px 12px;
    border: 1px solid #263241;
    border-radius: 999px;
    color: #7dd3fc;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.3px;
    margin-bottom: 28px;
    background: rgba(15, 22, 31, 0.72);
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(49px, 6.5vw, 82px);
    line-height: 0.98;
    letter-spacing: -4px;
  }

  h1 span {
    display: block;
    color: #7dd3fc;
  }

  .hero-text {
    max-width: 760px;
    margin: 30px 0;
    font-size: 19px;
    color: #aeb7c4;
  }

  .hero-buttons,
  .contact-actions,
  .project-actions {
    display: flex;
    gap: 11px;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 19px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 780;
    font-size: 14px;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .primary {
    background: #f4f7fb;
    color: #090c11;
  }

  .primary:hover {
    transform: translateY(-2px);
  }

  .secondary {
    color: white;
    border: 1px solid #2a3442;
    background: rgba(255, 255, 255, 0.01);
