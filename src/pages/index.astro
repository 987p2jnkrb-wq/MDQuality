---
const services = [
  {
    title: "QA & Software Testing",
    description:
      "Manual and exploratory testing focused on real user flows, edge cases and product quality.",
  },
  {
    title: "Test Automation",
    description:
      "Automation of repetitive testing and quality checks to speed up releases and reduce regression risk.",
  },
  {
    title: "API & Integration Testing",
    description:
      "Verification of APIs, integrations, data flows and communication between systems.",
  },
  {
    title: "Web Applications & MVPs",
    description:
      "Building focused web applications, internal tools and MVPs from idea to working product.",
  },
  {
    title: "Business Automation",
    description:
      "Simple tools and automations that remove repetitive work and improve everyday processes.",
  },
  {
    title: "Websites",
    description:
      "Fast, modern websites for businesses and professionals.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>MD Quality | Software Quality & Automation</title>

    <meta
      name="description"
      content="MD Quality provides software testing, QA automation, web applications and business automation."
    />
  </head>

  <body>
    <header>
      <nav class="container">
        <a class="logo" href="/">MD<span>Quality</span></a>

        <div class="nav-links">
          <a href="#services">Services</a>
          <a href="#projects">Projects</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero container">
        <div class="badge">Software Quality · Automation · Development</div>

        <h1>
          Better software.<br />
          <span>Tested. Automated. Built.</span>
        </h1>

        <p class="hero-text">
          MD Quality helps businesses improve software quality, automate testing
          and build practical web applications and internal tools.
        </p>

        <div class="hero-buttons">
          <a class="button primary" href="#contact">Work with me</a>
          <a class="button secondary" href="#projects">See my work</a>
        </div>
      </section>

      <section id="services" class="section container">
        <div class="section-heading">
          <p class="eyebrow">SERVICES</p>
          <h2>Quality engineering and practical software solutions.</h2>
        </div>

        <div class="services-grid">
          {
            services.map((service) => (
              <article class="card">
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="projects" class="section container">
        <div class="section-heading">
          <p class="eyebrow">PROJECTS</p>
          <h2>Building, not only testing.</h2>
        </div>

        <article class="project">
          <div>
            <p class="project-label">FEATURED PROJECT</p>

            <h3>Personal Finance Application</h3>

            <p>
              A web application designed to make personal budget management
              clearer and easier. Built as an end-to-end project covering
              product design, development and quality assurance.
            </p>

            <div class="tags">
              <span>Web App</span>
              <span>Finance</span>
              <span>QA</span>
              <span>Development</span>
            </div>
          </div>

          <div class="project-preview">
            Finance App
            <small>case study coming soon</small>
          </div>
        </article>
      </section>

      <section id="about" class="section container about">
        <div>
          <p class="eyebrow">ABOUT</p>

          <h2>Mikołaj Dworak</h2>

          <p class="about-lead">
            QA Engineer with 6+ years of experience in software testing,
            application support and product quality.
          </p>

          <p>
            I combine quality assurance experience with automation and
            application development. My focus is not just finding problems —
            but understanding products, improving processes and delivering
            working solutions.
          </p>
        </div>
      </section>

      <section id="contact" class="section container">
        <div class="contact">
          <p class="eyebrow">CONTACT</p>

          <h2>Have a project or need QA support?</h2>

          <p>
            I'm open to QA, automation, software development and B2B
            cooperation.
          </p>

          <a class="button primary" href="mailto:hello@mdquality.pl">
            hello@mdquality.pl
          </a>
        </div>
      </section>
    </main>

    <footer class="container">
      <div class="logo">MD<span>Quality</span></div>
      <p>© {new Date().getFullYear()} MD Quality · Mikołaj Dworak</p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background: #080b10;
    color: #f5f7fa;
    line-height: 1.6;
  }

  .container {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  header {
    border-bottom: 1px solid #1c222c;
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(8, 11, 16, 0.92);
    backdrop-filter: blur(12px);
  }

  nav {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.5px;
    text-decoration: none;
    color: white;
  }

  .logo span {
    color: #7dd3fc;
  }

  .nav-links {
    display: flex;
    gap: 28px;
  }

  .nav-links a {
    color: #9ba6b5;
    text-decoration: none;
    font-size: 14px;
  }

  .nav-links a:hover {
    color: white;
  }

  .hero {
    min-height: 680px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .badge {
    padding: 7px 12px;
    border: 1px solid #263241;
    border-radius: 999px;
    color: #7dd3fc;
    font-size: 13px;
    margin-bottom: 28px;
  }

  h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(50px, 8vw, 92px);
    line-height: 0.97;
    letter-spacing: -4px;
  }

  h1 span {
    color: #7dd3fc;
  }

  .hero-text {
    max-width: 680px;
    margin: 32px 0;
    font-size: 20px;
    color: #aeb7c4;
  }

  .hero-buttons {
    display: flex;
    gap: 12px;
  }

  .button {
    display: inline-block;
    padding: 13px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    transition: 0.2s;
  }

  .primary {
    background: #f4f7fb;
    color: #090c11;
  }

  .primary:hover {
    transform: translateY(-2px);
  }

  .secondary {
    color: white;
    border: 1px solid #2a3442;
  }

  .section {
    padding: 110px 0;
    border-top: 1px solid #171d26;
  }

  .section-heading {
    max-width: 700px;
    margin-bottom: 50px;
  }

  .eyebrow,
  .project-label {
    color: #7dd3fc;
    font-size: 12px;
    letter-spacing: 2px;
    font-weight: 800;
  }

  h2 {
    font-size: clamp(36px, 5vw, 55px);
    line-height: 1.1;
    letter-spacing: -2px;
    margin: 8px 0 20px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
  }

  .card {
    background: #0d1219;
    border: 1px solid #1d2631;
    border-radius: 14px;
    padding: 28px;
  }

  .card h3 {
    margin-top: 0;
    font-size: 20px;
  }

  .card p {
    color: #9ba6b5;
    margin-bottom: 0;
  }

  .project {
    background: #0d1219;
    border: 1px solid #1d2631;
    border-radius: 18px;
    padding: 42px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 50px;
    align-items: center;
  }

  .project h3 {
    font-size: 34px;
    margin: 8px 0;
  }

  .project p {
    color: #aeb7c4;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .tags span {
    border: 1px solid #263241;
    border-radius: 999px;
    padding: 5px 10px;
    color: #aeb7c4;
    font-size: 12px;
  }

  .project-preview {
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    background:
      radial-gradient(circle at 20% 20%, #17243a, transparent 45%),
      #090d13;
    border: 1px solid #202a37;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    font-weight: 800;
  }

  .project-preview small {
    font-size: 12px;
    color: #778292;
    font-weight: 500;
  }

  .about {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .about-lead {
    font-size: 22px;
    color: white;
  }

  .about p {
    color: #aeb7c4;
  }

  .contact {
    max-width: 750px;
    text-align: center;
    margin: 0 auto;
  }

  .contact p {
    color: #aeb7c4;
    margin-bottom: 32px;
  }

  footer {
    padding: 35px 0;
    border-top: 1px solid #171d26;
    display: flex;
    justify-content: space-between;
    color: #697586;
    font-size: 13px;
  }

  @media (max-width: 800px) {
    .nav-links {
      display: none;
    }

    h1 {
      letter-spacing: -2px;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .project {
      grid-template-columns: 1fr;
      padding: 25px;
    }

    footer {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>