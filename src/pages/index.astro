---
const services = [
  {
    title: "Software Testing & QA",
    description:
      "Functional, exploratory, pre-release, API, database and performance testing focused on real product risks and user scenarios.",
  },
  {
    title: "API & Integrations",
    description:
      "Testing APIs, integrations and data flows between systems, with clear diagnostics when something does not behave as expected.",
  },
  {
    title: "Application Support",
    description:
      "Technical support, monitoring, troubleshooting and investigation of application issues across client and product environments.",
  },
  {
    title: "Test & Process Automation",
    description:
      "Building repeatable checks and practical automations that reduce manual work and make delivery more reliable.",
  },
  {
    title: "Web Applications & MVPs",
    description:
      "Creating focused web applications, internal tools and MVPs from an idea to a working, testable product.",
  },
  {
    title: "Technical Coordination",
    description:
      "Documentation, issue ownership, cross-team communication and practical coordination between users, support, QA and development.",
  },
];

const capabilities = [
  "JavaScript",
  "TypeScript",
  "REST APIs",
  "Postman",
  "PostgreSQL",
  "JSON",
  "GitLab",
  "GitHub",
  "Jira",
  "Application Monitoring",
  "Technical Documentation",
  "AI-assisted Development",
];

const projectScreens = [
  {
    title: "Finance manager",
    src: "https://raw.githubusercontent.com/987p2jnkrb-wq/MyAnalyze/main/screenshots/Manager.png",
  },
  {
    title: "Statement import review",
    src: "https://raw.githubusercontent.com/987p2jnkrb-wq/MyAnalyze/main/screenshots/ImportCSV.png",
  },
  {
    title: "Monthly summary",
    src: "https://raw.githubusercontent.com/987p2jnkrb-wq/MyAnalyze/main/screenshots/Summary.png",
  },
  {
    title: "Financial goals",
    src: "https://raw.githubusercontent.com/987p2jnkrb-wq/MyAnalyze/main/screenshots/Goals.png",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#080b10" />

    <title>MD Quality | QA, Automation, Integrations & Web Applications</title>

    <meta
      name="description"
      content="MD Quality combines software testing, application support, API and integration work, automation and focused web application development."
    />
  </head>

  <body>
    <header>
      <nav class="container">
        <a class="logo" href="/" aria-label="MD Quality home">MD<span>Quality</span></a>

        <div class="nav-links">
          <a href="#services">Services</a>
          <a href="#projects">Projects</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero container">
        <div class="hero-copy">
          <div class="badge">Software Quality · Support · Automation · Applications</div>

          <h1>
            Test. Diagnose.<br />
            <span>Automate. Build.</span>
          </h1>

          <p class="hero-text">
            MD Quality helps businesses improve software quality, troubleshoot
            application problems, validate integrations, automate repetitive work
            and build practical web solutions.
          </p>

          <div class="hero-buttons">
            <a class="button primary" href="#contact">Start a conversation</a>
            <a class="button secondary" href="#services">Explore services</a>
          </div>
        </div>

        <div class="hero-stats" aria-label="Professional highlights">
          <div class="stat">
            <strong>6+ years</strong>
            <span>software quality and application support</span>
          </div>
          <div class="stat">
            <strong>QA + Support</strong>
            <span>testing, monitoring and troubleshooting</span>
          </div>
          <div class="stat">
            <strong>API + Data</strong>
            <span>integrations, databases and system flows</span>
          </div>
          <div class="stat">
            <strong>Build mindset</strong>
            <span>automation, internal tools and web applications</span>
          </div>
        </div>
      </section>

      <section id="services" class="section container">
        <div class="section-heading">
          <p class="eyebrow">SERVICES</p>
          <h2>Quality expertise with a wider technical perspective.</h2>
          <p class="section-intro">
            The core is software quality, but the work does not stop at finding bugs.
            I can help investigate problems, verify integrations, improve processes,
            automate repetitive work and build focused solutions.
          </p>
        </div>

        <div class="services-grid">
          {
            services.map((service, index) => (
              <article class="card">
                <span class="card-number">{String(index + 1).padStart(2, "0")}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="projects" class="section container">
        <div class="section-heading">
          <p class="eyebrow">PROJECTS</p>
          <h2>From testing software to building it.</h2>
          <p class="section-intro">
            Personal projects let me combine product thinking, development and QA in
            one place, instead of looking at quality only from the outside.
          </p>
        </div>

        <article class="project">
          <div class="project-copy">
            <p class="project-label">FEATURED PROJECT</p>

            <h3>MyAnalyze</h3>

            <p>
              An offline-first desktop application for planning, tracking and
              reconciling personal finances. It combines manual budgeting with bank
              statement imports, plan-versus-actual tracking, duplicate detection,
              transfer matching and local SQLite storage.
            </p>

            <div class="tags">
              <span>React</span>
              <span>TypeScript</span>
              <span>Node.js</span>
              <span>SQLite</span>
              <span>Electron</span>
              <span>Jest</span>
            </div>

            <div class="project-actions">
              <a
                class="button secondary"
                href="https://github.com/987p2jnkrb-wq/MyAnalyze"
                target="_blank"
                rel="noreferrer"
              >
                View project on GitHub
              </a>
            </div>
          </div>

          <a
            class="project-preview project-image-link"
            href={projectScreens[0].src}
            target="_blank"
            rel="noreferrer"
            aria-label="Open MyAnalyze finance manager screenshot"
          >
            <img
              src={projectScreens[0].src}
              alt="MyAnalyze finance manager interface"
              loading="lazy"
            />
          </a>
        </article>

        <div class="project-gallery" aria-label="MyAnalyze screenshots">
          {
            projectScreens.slice(1).map((screen) => (
              <a
                class="project-shot"
                href={screen.src}
                target="_blank"
                rel="noreferrer"
              >
                <img src={screen.src} alt={`MyAnalyze - ${screen.title}`} loading="lazy" />
                <span>{screen.title}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section id="about" class="section container about-section">
        <div class="about-copy">
          <p class="eyebrow">ABOUT</p>

          <h2>Mikołaj Dworak</h2>

          <p class="about-lead">
            Software quality and technical support specialist with 6+ years of
            experience working with business applications and software products.
          </p>

          <p>
            My background combines functional and pre-release testing, API and
            database testing, performance verification, application monitoring,
            technical support and troubleshooting.
          </p>

          <p>
            I have worked directly with developers, users and product environments
            to diagnose problems, document solutions and improve day-to-day
            operations. I also have experience leading a technical support team.
          </p>

          <p>
            Today I am expanding that foundation into test automation, business
            automation, AI-assisted development and building web applications.
            MD Quality is where these areas come together.
          </p>
        </div>

        <aside class="about-panel">
          <p class="panel-label">HOW I WORK</p>
          <ul>
            <li>Understand the product and real user flow first</li>
            <li>Look for root causes, not only symptoms</li>
            <li>Keep communication and documentation clear</li>
            <li>Automate work when repetition stops adding value</li>
            <li>Use modern tools to move from problem to solution faster</li>
          </ul>
        </aside>
      </section>

      <section class="section container">
        <div class="section-heading toolkit-heading">
          <div>
            <p class="eyebrow">TOOLKIT</p>
            <h2>Tools and technologies I work with.</h2>
          </div>
          <p class="section-intro">
            A practical stack built around testing, integrations, data, support and
            modern web development.
          </p>
        </div>

        <div class="capabilities">
          {capabilities.map((capability) => <span>{capability}</span>)}
        </div>
      </section>

      <section id="contact" class="section container">
        <div class="contact">
          <p class="eyebrow">LET'S WORK TOGETHER</p>

          <h2>Need better quality, clearer diagnostics or a practical software solution?</h2>

          <p>
            I'm open to QA, application support, integrations, automation,
            web application development and B2B cooperation.
          </p>

          <div class="contact-actions">
            <a class="button primary" href="mailto:hello@mdquality.pl">
              hello@mdquality.pl
            </a>
            <a
              class="button secondary"
              href="https://www.linkedin.com/in/mikdwo/"
              target="_blank"
              rel="noreferrer"
            >
              LinkedIn
            </a>
            <a
              class="button secondary"
              href="https://github.com/987p2jnkrb-wq"
              target="_blank"
              rel="noreferrer"
            >
              GitHub
            </a>
            <a class="button secondary" href="#projects">See current work</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="container">
      <div class="logo">MD<span>Quality</span></div>
      <p>© {new Date().getFullYear()} MD Quality · Mikołaj Dworak</p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at 80% 8%, rgba(51, 110, 151, 0.13), transparent 30%),
      #080b10;
    color: #f5f7fa;
    line-height: 1.6;
  }

  :global(::selection) {
    background: #7dd3fc;
    color: #071019;
  }

  .container {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  header {
    border-bottom: 1px solid rgba(35, 45, 58, 0.75);
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(8, 11, 16, 0.88);
    backdrop-filter: blur(16px);
  }

  nav {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.5px;
    text-decoration: none;
    color: white;
  }

  .logo span {
    color: #7dd3fc;
  }

  .nav-links {
    display: flex;
    gap: 28px;
  }

  .nav-links a {
    color: #9ba6b5;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: white;
  }

  .hero {
    min-height: 720px;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.65fr);
    gap: 70px;
    align-items: center;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .hero-copy {
    min-width: 0;
  }

  .badge {
    display: inline-flex;
    padding: 7px 12px;
    border: 1px solid #263241;
    border-radius: 999px;
    color: #7dd3fc;
    font-size: 12px;
    letter-spacing: 0.25px;
    margin-bottom: 28px;
    background: rgba(15, 22, 31, 0.7);
  }

  h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(52px, 7.8vw, 92px);
    line-height: 0.98;
    letter-spacing: -4px;
  }

  h1 span {
    color: #7dd3fc;
  }

  .hero-text {
    max-width: 720px;
    margin: 32px 0;
    font-size: 20px;
    color: #aeb7c4;
  }

  .hero-buttons,
  .contact-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 13px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .primary {
    background: #f4f7fb;
    color: #090c11;
  }

  .primary:hover {
    transform: translateY(-2px);
  }

  .secondary {
    color: white;
    border: 1px solid #2a3442;
  }

  .secondary:hover {
    border-color: #506176;
    background: rgba(255, 255, 255, 0.03);
  }

  .hero-stats {
    display: grid;
    gap: 10px;
  }

  .stat {
    padding: 22px;
    border: 1px solid #1d2631;
    border-radius: 14px;
    background: rgba(13, 18, 25, 0.82);
  }

  .stat strong {
    display: block;
    margin-bottom: 4px;
    font-size: 18px;
    color: #f5f7fa;
  }

  .stat span {
    display: block;
    color: #8996a6;
    font-size: 13px;
    line-height: 1.45;
  }

  .section {
    padding: 110px 0;
    border-top: 1px solid #171d26;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 50px;
  }

  .section-intro {
    max-width: 700px;
    color: #99a6b6;
    font-size: 17px;
    margin: 18px 0 0;
  }

  .eyebrow,
  .project-label,
  .panel-label,
  .preview-kicker {
    color: #7dd3fc;
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: 800;
  }

  h2 {
    font-size: clamp(36px, 5vw, 55px);
    line-height: 1.08;
    letter-spacing: -2px;
    margin: 8px 0 20px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
  }

  .card {
    min-height: 225px;
    background: #0d1219;
    border: 1px solid #1d2631;
    border-radius: 14px;
    padding: 28px;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: #334356;
  }

  .card-number {
    display: block;
    color: #546173;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 34px;
  }

  .card h3 {
    margin: 0 0 10px;
    font-size: 20px;
  }

  .card p {
    color: #9ba6b5;
    margin-bottom: 0;
  }

  .project {
    position: relative;
    overflow: hidden;
    background: #0d1219;
    border: 1px solid #1d2631;
    border-radius: 18px;
    padding: 42px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 50px;
    align-items: center;
  }

  .project::before {
    content: "";
    position: absolute;
    inset: auto -80px -130px auto;
    width: 330px;
    height: 330px;
    border-radius: 50%;
    background: rgba(66, 153, 225, 0.07);
    filter: blur(12px);
    pointer-events: none;
  }

  .project-copy {
    position: relative;
    z-index: 1;
  }

  .project h3 {
    font-size: 36px;
    line-height: 1.15;
    margin: 8px 0 15px;
  }

  .project p {
    color: #aeb7c4;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .tags span,
  .capabilities span {
    border: 1px solid #263241;
    border-radius: 999px;
    padding: 6px 11px;
    color: #aeb7c4;
    font-size: 12px;
    background: rgba(10, 14, 20, 0.6);
  }

  .project-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .project-preview {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    background: #090d13;
    border: 1px solid #202a37;
    overflow: hidden;
  }

  .project-image-link {
    display: block;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .project-image-link:hover {
    transform: translateY(-3px);
    border-color: #3b5168;
  }

  .project-preview img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: top left;
  }

  .project-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 15px;
  }

  .project-shot {
    display: block;
    overflow: hidden;
    border: 1px solid #1d2631;
    border-radius: 14px;
    background: #0d1219;
    text-decoration: none;
    color: #d9e0e8;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .project-shot:hover {
    transform: translateY(-3px);
    border-color: #3b5168;
  }

  .project-shot img {
    width: 100%;
    aspect-ratio: 16 / 10;
    display: block;
    object-fit: cover;
    object-position: top left;
    border-bottom: 1px solid #1d2631;
  }

  .project-shot span {
    display: block;
    padding: 13px 15px;
    font-size: 13px;
    font-weight: 700;
  }

  .about-section {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: 70px;
    align-items: start;
  }

  .about-lead {
    font-size: 23px;
    color: #e9eef5;
    line-height: 1.5;
  }

  .about-copy > p:not(.eyebrow):not(.about-lead) {
    color: #9ba6b5;
    font-size: 16px;
  }

  .about-panel {
    margin-top: 45px;
    padding: 28px;
    border: 1px solid #1d2631;
    border-radius: 14px;
    background: #0d1219;
  }

  .about-panel ul {
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .about-panel li {
    position: relative;
    padding: 13px 0 13px 22px;
    border-top: 1px solid #19212b;
    color: #a7b2c0;
    font-size: 14px;
  }

  .about-panel li:first-child {
    border-top: 0;
  }

  .about-panel li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 22px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7dd3fc;
  }

  .toolkit-heading {
    max-width: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: end;
  }

  .toolkit-heading .section-intro {
    margin: 0 0 8px;
  }

  .capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .capabilities span {
    padding: 9px 14px;
    font-size: 13px;
  }

  .contact {
    max-width: 820px;
    text-align: center;
    margin: 0 auto;
  }

  .contact p {
    color: #aeb7c4;
    margin: 0 auto 32px;
    max-width: 650px;
    font-size: 17px;
  }

  .contact-actions {
    justify-content: center;
  }

  footer {
    padding: 35px 0;
    border-top: 1px solid #171d26;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #697586;
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .hero,
    .about-section {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .hero {
      padding-top: 110px;
    }

    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .toolkit-heading {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .about-panel {
      margin-top: 0;
    }
  }

  @media (max-width: 700px) {
    .nav-links {
      display: none;
    }

    h1 {
      letter-spacing: -2px;
    }

    .hero {
      min-height: auto;
    }

    .hero-stats,
    .services-grid,
    .project,
    .project-gallery {
      grid-template-columns: 1fr;
    }

    .project {
      padding: 25px;
      gap: 30px;
    }

    .section {
      padding: 80px 0;
    }

    footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  @media (max-width: 450px) {
    .container {
      width: min(100% - 28px, 1120px);
    }

    h1 {
      font-size: clamp(46px, 16vw, 64px);
    }

    .hero-stats {
      grid-template-columns: 1fr;
    }

    .hero-buttons,
    .contact-actions {
      width: 100%;
    }

    .button {
      text-align: center;
      flex: 1 1 100%;
    }
  }
</style>
